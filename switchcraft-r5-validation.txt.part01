===== supplemental host reproducer: run-localhost-audit.sh =====
#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
AUDIT_DIR="$1"
SOURCE_ROOT="$ROOT/.deps/openjdk25-source"
HOST_JDK="$ROOT/.deps/host-jdk25/jdk-25.0.5+8"
printf 'ROOT=%s\nAUDIT_DIR=%s\nHEAD=%s\n' "$ROOT" "$AUDIT_DIR" "$(git rev-parse HEAD)"
mkdir -p "$AUDIT_DIR/source" "$AUDIT_DIR/patch-classes" "$AUDIT_DIR/test-classes" "$AUDIT_DIR/cwd/sdmc:/switch/mc runtime/測試"
FILES=(
  src/java.base/share/classes/sun/net/www/ParseUtil.java
  src/java.base/unix/classes/jdk/internal/loader/FileURLMapper.java
  src/java.base/share/classes/jdk/internal/loader/URLClassPath.java
  src/java.base/share/classes/sun/net/www/protocol/jar/URLJarFile.java
  src/java.base/unix/classes/sun/net/www/protocol/file/Handler.java
)
for FILE in "${FILES[@]}"; do
  mkdir -p "$AUDIT_DIR/source/$(dirname "$FILE")"
  cp "$SOURCE_ROOT/$FILE" "$AUDIT_DIR/source/$FILE"
done
python3 - "$ROOT" "$AUDIT_DIR" <<'PY'
from pathlib import Path
import re
import sys
root, audit = map(Path, sys.argv[1:])
selected = {
    'src/java.base/share/classes/sun/net/www/ParseUtil.java',
    'src/java.base/unix/classes/jdk/internal/loader/FileURLMapper.java',
    'src/java.base/share/classes/jdk/internal/loader/URLClassPath.java',
    'src/java.base/share/classes/sun/net/www/protocol/jar/URLJarFile.java',
    'src/java.base/unix/classes/sun/net/www/protocol/file/Handler.java',
}
source = (root / 'patches/openjdk25/0013-horizon-java-base-platform-sources.patch').read_text()
headers = list(re.finditer(r'^--- a/(.+)\n', source, re.M))
sections = []
for i, match in enumerate(headers):
    if match.group(1) in selected:
        end = headers[i + 1].start() if i + 1 < len(headers) else len(source)
        sections.append(source[match.start():end])
if {re.search(r'^--- a/(.+)$', s, re.M).group(1) for s in sections} != selected:
    raise SystemExit('filtered patch does not contain exactly the five requested source files')
(audit / 'classpath-0013-filtered.patch').write_text(''.join(sections))
PY
printf 'Applying only five filtered patch sections from tracked 0013 with --fuzz=0\n'
(cd "$AUDIT_DIR/source" && patch -p1 --batch --fuzz=0 -i "$AUDIT_DIR/classpath-0013-filtered.patch")
PATCHED=(
  "$AUDIT_DIR/source/src/java.base/share/classes/sun/net/www/ParseUtil.java"
  "$AUDIT_DIR/source/src/java.base/unix/classes/jdk/internal/loader/FileURLMapper.java"
  "$AUDIT_DIR/source/src/java.base/share/classes/jdk/internal/loader/URLClassPath.java"
  "$AUDIT_DIR/source/src/java.base/share/classes/sun/net/www/protocol/jar/URLJarFile.java"
  "$AUDIT_DIR/source/src/java.base/unix/classes/sun/net/www/protocol/file/Handler.java"
)
PATCH_PATH="$(dirname "${PATCHED[0]}"):$(dirname "${PATCHED[1]}"):$(dirname "${PATCHED[2]}"):$(dirname "${PATCHED[3]}"):$(dirname "${PATCHED[4]}")"
"$HOST_JDK/bin/javac" --patch-module "java.base=$PATCH_PATH" -d "$AUDIT_DIR/patch-classes" "${PATCHED[@]}"
cat > "$AUDIT_DIR/LocalhostClasspathAudit.java" <<'JAVA'
import java.net.URI;
import java.net.URL;
import java.net.URLClassLoader;
import java.nio.charset.StandardCharsets;

public final class LocalhostClasspathAudit {
    public static void main(String[] args) throws Exception {
        URL onlyUrl = URI.create("file://localhost/sdmc%3A/switch/mc%20runtime/%E6%B8%AC%E8%A9%A6/payload.jar").toURL();
        if (!"localhost".equals(onlyUrl.getHost())) {
            throw new AssertionError("Expected localhost authority, got " + onlyUrl.getHost());
        }
        try (URLClassLoader loader = new URLClassLoader(new URL[] {onlyUrl}, null)) {
            if (loader.getURLs().length != 1) {
                throw new AssertionError("Expected exactly one class path URL");
            }
            Class<?> payload = loader.loadClass("hostclasspath.SdmcClasspathPayload");
            String marker = (String) payload.getMethod("marker").invoke(null);
            if (!"loaded-from-sdmc-jar".equals(marker)) {
                throw new AssertionError("Unexpected marker: " + marker);
            }
            try (var stream = loader.getResourceAsStream("payload.txt")) {
                if (stream == null) throw new AssertionError("JAR resource was missing");
                String content = new String(stream.readAllBytes(), StandardCharsets.UTF_8);
                if (!"localhost-resource-read\n".equals(content)) {
                    throw new AssertionError("Unexpected JAR resource: " + content);
                }
            }
        }
        System.out.println("HOST-PASSED: sole localhost file URL loaded payload class and read JAR resource; Horizon NOT TESTED");
    }
}
JAVA
"$HOST_JDK/bin/javac" -Xlint:all -Werror -d "$AUDIT_DIR/test-classes" \
  "$ROOT/ports/openjdk25/tests/java_paths/SdmcClasspathPayload.java" \
  "$AUDIT_DIR/LocalhostClasspathAudit.java"
printf 'localhost-resource-read\n' > "$AUDIT_DIR/cwd/sdmc:/switch/mc runtime/測試/payload.txt"
"$HOST_JDK/bin/jar" --create --file "$AUDIT_DIR/cwd/sdmc:/switch/mc runtime/測試/payload.jar" \
  -C "$AUDIT_DIR/test-classes" hostclasspath/SdmcClasspathPayload.class \
  -C "$AUDIT_DIR/cwd/sdmc:/switch/mc runtime/測試" payload.txt
(cd "$AUDIT_DIR/cwd" && "$HOST_JDK/bin/java" --patch-module "java.base=$AUDIT_DIR/patch-classes" \
  -Dos.name=Horizon -cp "$AUDIT_DIR/test-classes" LocalhostClasspathAudit)


