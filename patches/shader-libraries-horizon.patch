 namespace {
 
+#if defined(LWJGL_HORIZON_SHADERC)
+// libnx mutexes use the Horizon kernel's arbitration primitive.  Shaderc's
+// glslang has process-wide state, so all compile and assembly calls are
+// serialized with a real Horizon recursive mutex.
+static RMutex horizon_shaderc_compile_mutex;
+class HorizonShadercCompileLock {
+ public:
+  HorizonShadercCompileLock() { rmutexLock(&horizon_shaderc_compile_mutex); }
+  ~HorizonShadercCompileLock() { rmutexUnlock(&horizon_shaderc_compile_mutex); }
+};
+#else
+class HorizonShadercCompileLock {};
+#endif
