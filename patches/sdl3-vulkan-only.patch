diff --git a/src/video/switch/SDL_switchvulkan.c b/src/video/switch/SDL_switchvulkan.c
index ce3ed4a..e695858 100644
--- a/src/video/switch/SDL_switchvulkan.c
+++ b/src/video/switch/SDL_switchvulkan.c
@@ -80,11 +80,15 @@ bool SWITCH_Vulkan_CreateSurface(SDL_VideoDevice *_this, SDL_Window *window, VkI
 
     // The swapchain needs the window's buffer queue to itself: a GL surface
     // made for this window (SDL_GPU claims plain windows) has to go first.
+#ifdef SDL_VIDEO_OPENGL_EGL
     if (data && data->egl_surface != EGL_NO_SURFACE) {
         SDL_EGL_MakeCurrent(_this, NULL, NULL);
         SDL_EGL_DestroySurface(_this, data->egl_surface);
         data->egl_surface = EGL_NO_SURFACE;
     }
+#else
+    (void)data;
+#endif
 
     VkViSurfaceCreateInfoNN createInfo;
     SDL_zero(createInfo);
